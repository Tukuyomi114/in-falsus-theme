{
  "name": "@local/in-falsus",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tukuyomi114/in-falsus-theme.git"
  },
  "description": "In Falsus 风格主题：深板岩底色、冷青/品红双色、原创碎玻璃棱镜品牌标、切角薄板聊天区与开场影片",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "media/*.mp4"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
